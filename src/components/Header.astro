---
import { Image } from 'astro:assets';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
import BirneLogo from './BirneLogo.astro';
---


<style>
	header {
		margin: 0;
		padding: 0 1em;
		box-shadow: 0 2px 8px var(--color-bg);
		
		background: var(--color-bg);
		color: var(--color-text);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		overflow: hidden;
	}
	nav a {
		padding: 1em 1em;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		color: var(--color-text);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}

	.internal-links {
		align-self: stretch;
		display: flex;
		gap: 0rem;
	}

	@media (max-width: 700px) {
		.social-links {
			display: none;
		}
	}

	h2 {
		margin: 0.5em;
		font-size: 1.2em;
		transition: transform 0.3s ease;
	}
	h2 a {
		display: flex;
		flex-wrap: nowrap;
		align-items: center;
		padding: 0;
	}

	.logo {
		height: 3em;
		width: auto;
		margin-right: 0.5em;
		color: var(--color-text);
	}

	h2:hover {
		transform: rotate(-5deg);
		transition: transform 0.3s ease 2s;
		animation: wiggle 1s ease-in-out 2.3s infinite;
	}

	@keyframes wiggle {
		0%   { transform: rotate(-5deg); }
		50%  { transform: rotate(5deg); }
		100% { transform: rotate(-5deg); }
	}
	
</style>

<header>
	<nav>
		<h2>
			<a href="/"><BirneLogo class="logo"/>BirnB4um</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/projects">Projects</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
		<!-- <div class="social-links">
			<SocialLinks/> <Image class="logo" src={birne_logo} alt=""/> <BirneLogo class="logo"/>
		</div> -->
		<ThemeToggle/>
	</nav>
</header>

