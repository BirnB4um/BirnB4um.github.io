---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import { Code } from "astro:components";
const js_code = `const n = 5;
for (let i = 0; i < n; i++) {
    solve();
}`;
---


<style>
	#bg {
		position: fixed;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		z-index: -1;
		background: var(--color-bg-2);
	}

	main {
		background: none;
		color: var(--color-text);
		width: 800px;
		max-width: calc(100% - 2rem);
		margin: 2em auto;
	}

	p {
		font-size: 1.2em;
		line-height: 1.6em;
		margin: 0.5em 0;
		text-align: justify;
		text-justify: inter-word;
	}

	a {
		color: var(--color-text);
	}


</style>


<BaseLayout>
	<main>
		<canvas id="bg"></canvas>
		<h1>Welcome! \o/</h1>
		<p>
			Hey, I'm Thimo, online I go by BirnB4um.<br>
			I spend my free time building random projects, writing little tools, and exploring data.<br>
			This website is a place to showcase the stuff I'm working on and share my thoughts.<br>
			It should also help me push myself to actually finish more of those projects instead of leaving them half-done :P<br>
		</p>
		<br/>
		<i>Note: This website is still under construction, so be patient as I work on it and add all my projects :)</i>
	</main>
</BaseLayout>

